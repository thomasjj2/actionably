{
  "name": "Actionably",
  "short_name": "Actionably",
  "description": "Turn what you save into what you do.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#100f2c",
  "theme_color": "#100f2c",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "shots",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}